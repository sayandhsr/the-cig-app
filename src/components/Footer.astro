---
---
<footer class="bg-background pt-24 pb-12 border-t border-white/5 relative overflow-hidden">
  <div class="absolute inset-0 bg-hero-glow opacity-10 pointer-events-none"></div>
  
  <div class="max-w-7xl mx-auto px-6 md:px-12 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">
      
      <div class="lg:col-span-1">
        <div class="text-3xl font-display font-bold tracking-widest text-gold mb-4">KILL SWITCH</div>
        <p class="text-xs text-gold tracking-widest uppercase mb-6">SMOKE. CONNECT. TALK.</p>
        <div class="inline-block px-3 py-1 rounded bg-red-900/20 border border-red-500/20 text-xs font-bold text-red-400 mb-4">
          18+ ONLY
        </div>
        <p class="text-sm text-muted">Social connection platform for adults.</p>
      </div>

      <div>
        <h4 class="text-cream font-medium tracking-widest mb-6 text-sm">EXPLORE</h4>
        <ul class="space-y-4">
          <li><a href="/discover" class="text-muted hover:text-gold text-sm transition-colors">Discover</a></li>
          <li><a href="/spot-chat" class="text-muted hover:text-gold text-sm transition-colors">Spot Chat</a></li>
          <li><a href="/global-chat" class="text-muted hover:text-gold text-sm transition-colors">Global Chat</a></li>
          <li><a href="/debates" class="text-muted hover:text-gold text-sm transition-colors">Debates</a></li>
          <li><a href="/community" class="text-muted hover:text-gold text-sm transition-colors">Community</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-cream font-medium tracking-widest mb-6 text-sm">LEGAL & SAFETY</h4>
        <ul class="space-y-4">
          <li><a href="/safety" class="text-muted hover:text-gold text-sm transition-colors">Safety Guidelines</a></li>
          <li><a href="/privacy" class="text-muted hover:text-gold text-sm transition-colors">Privacy Policy</a></li>
          <li><a href="/terms" class="text-muted hover:text-gold text-sm transition-colors">Terms of Service</a></li>
          <li><a href="/age-policy" class="text-muted hover:text-gold text-sm transition-colors">Age Policy</a></li>
        </ul>
      </div>
      
      <div>
        <h4 class="text-cream font-medium tracking-widest mb-6 text-sm">STAY CONNECTED</h4>
        <p class="text-sm text-muted mb-4">Join our newsletter for community updates.</p>
        <div class="flex">
          <input type="email" placeholder="Email Address" class="bg-surface border border-white/10 px-4 py-2 rounded-l-md w-full text-sm focus:outline-none focus:border-gold text-cream" />
          <button class="bg-gold text-background px-4 py-2 rounded-r-md font-bold text-sm hover:bg-gold-light transition-colors">JOIN</button>
        </div>
      </div>
    </div>
    
    <div class="pt-8 border-t border-white/5 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-xs text-muted">© {new Date().getFullYear()} KILL SWITCH. All rights reserved.</p>
      <p class="text-xs text-muted/50">Designed responsibly for adult socialization.</p>
    </div>
  </div>
</footer>
