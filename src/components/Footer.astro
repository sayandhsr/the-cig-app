---
---
<footer class="bg-vintage-charcoal pt-24 pb-12 border-t-[8px] border-white relative overflow-hidden">
  <div class="absolute inset-0 bg-grunge opacity-20 mix-blend-multiply pointer-events-none"></div>
  
  <div class="max-w-7xl mx-auto px-6 md:px-12 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">
      
      <div class="lg:col-span-1">
        <div class="text-4xl font-display uppercase tracking-widest text-vintage-paper mb-4"><span class="text-vintage-red">KILL</span> SWITCH</div>
        <div class="inline-block px-3 py-1 bg-vintage-red border-[2px] border-white text-xs font-display tracking-[0.2em] uppercase text-white mb-6 shadow-[2px_2px_0px_0px_#dfcdb4]">
          18+ ONLY
        </div>
        <p class="text-sm text-vintage-paper/70 font-serif italic border-l-2 border-vintage-red pl-3">A dedicated community for those who appreciate the culture.</p>
      </div>

      <div>
        <h4 class="text-vintage-red font-display uppercase tracking-[0.2em] mb-6 text-sm">EXPLORE</h4>
        <ul class="space-y-4">
          <li><a href="/discover" class="text-vintage-paper/80 hover:text-vintage-red text-sm font-sans tracking-widest uppercase transition-all">Discover</a></li>
          <li><a href="/spot-chat" class="text-vintage-paper/80 hover:text-vintage-red text-sm font-sans tracking-widest uppercase transition-all">Spot Chat</a></li>
          <li><a href="/global-chat" class="text-vintage-paper/80 hover:text-vintage-red text-sm font-sans tracking-widest uppercase transition-all">Global Chat</a></li>
          <li><a href="/debates" class="text-vintage-paper/80 hover:text-vintage-red text-sm font-sans tracking-widest uppercase transition-all">Debates</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-vintage-red font-display uppercase tracking-[0.2em] mb-6 text-sm">LEGAL & SAFETY</h4>
        <ul class="space-y-4">
          <li><a href="/legal" class="text-vintage-paper/80 hover:text-vintage-red text-sm font-sans tracking-widest uppercase transition-all">Terms of Service</a></li>
          <li><a href="/legal" class="text-vintage-paper/80 hover:text-vintage-red text-sm font-sans tracking-widest uppercase transition-all">Privacy Policy</a></li>
        </ul>
      </div>
      
      <div>
        <h4 class="text-vintage-red font-display uppercase tracking-[0.2em] mb-6 text-sm">STAY CONNECTED</h4>
        <div class="flex">
          <input type="email" placeholder="EMAIL ADDRESS" class="bg-vintage-paper border-[4px] border-transparent px-4 py-3 w-full text-sm focus:outline-none focus:border-vintage-red text-vintage-charcoal font-sans tracking-widest uppercase placeholder:text-vintage-charcoal/50" />
          <button class="bg-vintage-red text-white px-6 py-3 font-display uppercase tracking-[0.2em] text-sm hover:bg-white hover:text-vintage-red border-[4px] border-transparent hover:border-vintage-red transition-all">JOIN</button>
        </div>
      </div>
    </div>
    
    <div class="pt-8 border-t-[4px] border-vintage-paper/10 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-xs text-vintage-paper/50 font-sans tracking-widest uppercase"> {new Date().getFullYear()} KILL SWITCH. All rights reserved.</p>
    </div>
  </div>
</footer>
