---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Sorry - 18+ Only">
  <main className="min-h-screen bg-background flex flex-col items-center justify-center p-6 relative overflow-hidden">
    <div className="absolute inset-0 bg-hero-glow opacity-30"></div>
    <div className="relative z-10 glass-card p-12 rounded-3xl max-w-lg text-center border border-white/5">
      <div className="w-20 h-20 mx-auto rounded-full border border-red-500/30 bg-red-500/10 flex items-center justify-center mb-6">
        <span className="text-2xl font-bold text-red-400">18+</span>
      </div>
      <h1 className="text-4xl font-display font-bold text-cream mb-4">Access Denied</h1>
      <p className="text-lg text-muted mb-8 leading-relaxed">
        We are sorry, but you must be at least 18 years old to access this application. 
      </p>
      <a href="/" className="inline-block py-4 px-8 rounded-full border border-white/10 text-cream font-medium tracking-widest hover:bg-white/5 transition-colors">
        RETURN HOME
      </a>
    </div>
  </main>
</Layout>
