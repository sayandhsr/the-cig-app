---
import Layout from '../layouts/Layout.astro';
import { MapPin } from 'lucide-react';
---

<Layout title="Spot Chat | KILL SWITCH">
  <div class="pt-32 pb-16 px-6 md:px-12 max-w-5xl mx-auto">
    <div class="mb-12 flex flex-col md:flex-row justify-between items-end gap-6">
      <div>
        <h1 class="text-4xl font-display font-bold text-cream mb-2">Spot Chat</h1>
        <p class="text-muted">Join local discussions based on approximate areas.</p>
      </div>
      <button class="px-6 py-2 rounded-full bg-white/5 border border-white/10 text-cream font-medium tracking-wide hover:bg-white/10 transition-colors">
        Find My Area
      </button>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {[
        { name: 'Downtown District', active: 24, distance: '1.2 mi' },
        { name: 'University Campus', active: 89, distance: '3.4 mi' },
        { name: 'Arts Quarter', active: 12, distance: '4.1 mi' },
        { name: 'Riverfront', active: 34, distance: '5.0 mi' },
        { name: 'Financial Center', active: 8, distance: '6.2 mi' },
        { name: 'Westside Lounge', active: 45, distance: '8.5 mi' }
      ].map(spot => (
        <div class="glass-card p-6 rounded-2xl flex flex-col hover:-translate-y-1 transition-transform cursor-pointer group">
          <div class="flex items-start justify-between mb-4">
            <div class="w-10 h-10 rounded-full bg-tobacco/30 flex items-center justify-center text-gold group-hover:bg-gold group-hover:text-background transition-colors">
              <MapPin class="w-5 h-5" />
            </div>
            <div class="px-2 py-1 bg-green-500/10 text-green-400 text-[10px] font-bold rounded flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse"></span>
              {spot.active} ACTIVE
            </div>
          </div>
          
          <h3 class="text-xl font-display font-bold text-cream mb-1">{spot.name}</h3>
          <p class="text-sm text-muted mb-6">{spot.distance} away</p>
          
          <button class="mt-auto w-full py-2 border border-white/10 rounded-lg text-sm font-medium tracking-wide text-cream group-hover:border-gold group-hover:text-gold transition-colors">
            JOIN SPOT
          </button>
        </div>
      ))}
    </div>
  </div>
</Layout>
