---
import Layout from '../layouts/Layout.astro';
import SpotChatComponent from '../components/SpotChat.jsx';
---

<Layout title="Spot Chat | KILL SWITCH">
  <div class="pt-32 pb-16 px-6 md:px-12 max-w-7xl mx-auto">
    <div class="mb-12 flex flex-col md:flex-row justify-between items-end gap-6">
      <div>
        <h1 class="text-4xl font-display font-bold text-cream mb-2">Spot Chat</h1>
        <p class="text-muted">Chat with others within a 15km radius of your location.</p>
      </div>
    </div>

    <SpotChatComponent client:only="react" />
  </div>
</Layout>
