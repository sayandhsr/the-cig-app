---
import Layout from '../layouts/Layout.astro';
import GlobalChatComponent from '../components/GlobalChat.jsx';
---

<Layout title="Global Chat | KILL SWITCH">
  <div class="pt-32 pb-16 px-6 md:px-12 max-w-5xl mx-auto">
    <div class="mb-8">
      <h1 class="text-4xl font-display font-bold text-cream mb-2">Global Chat</h1>
      <p class="text-muted">Connect with the worldwide community.</p>
    </div>
    <GlobalChatComponent client:only="react" />
  </div>
</Layout>
