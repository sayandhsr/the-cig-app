---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Community | KILL SWITCH">
  <div class="pt-32 pb-16 px-6 md:px-12 max-w-5xl mx-auto">
    <div class="mb-12 text-center">
      <h1 class="text-4xl md:text-6xl font-display font-bold text-cream mb-4">The 101 Club</h1>
      <p class="text-muted max-w-2xl mx-auto text-lg">Build meaningful connections and earn your place in the community hall of fame.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
      <div class="glass-card p-8 rounded-2xl flex flex-col items-center text-center">
        <div class="w-32 h-32 rounded-full border-[4px] border-surface bg-background shadow-[0_0_30px_rgba(212,175,55,0.2)] flex items-center justify-center mb-6 relative">
          <div class="absolute inset-2 border border-gold/30 rounded-full border-dashed animate-spin-slow"></div>
          <span class="text-4xl font-display font-bold text-gold">101</span>
          <span class="absolute -bottom-3 px-3 py-1 bg-surface border border-gold text-gold text-xs font-bold rounded-full">×1</span>
        </div>
        <h3 class="text-2xl font-display font-bold text-cream mb-2">The 101 Badge</h3>
        <p class="text-muted mb-8">Awarded to members who have made 101 meaningful connections inside the platform.</p>
        
        <div class="w-full bg-surface h-2 rounded-full overflow-hidden mb-2">
          <div class="bg-gold h-full w-[67%] shadow-[0_0_10px_#D4AF37]"></div>
        </div>
        <p class="text-xs text-muted font-medium tracking-widest uppercase text-right w-full">67 / 101 Connections</p>
      </div>

      <div class="flex flex-col justify-center">
        <h3 class="text-2xl font-display font-bold text-cream mb-6">Recent Achievers</h3>
        <div class="space-y-4">
          {[
            { name: 'SmokeLegend', badge: '×4', conns: 404 },
            { name: 'NightOwl', badge: '×2', conns: 202 },
            { name: 'ClassicBlend', badge: '×1', conns: 101 }
          ].map(user => (
            <div class="flex items-center justify-between p-4 glass-card rounded-xl">
              <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-full bg-tobacco flex items-center justify-center font-display font-bold text-cream">
                  {user.name.charAt(0)}
                </div>
                <div>
                  <div class="font-medium text-cream">{user.name}</div>
                  <div class="text-xs text-muted">{user.conns} total connections</div>
                </div>
              </div>
              <div class="px-3 py-1 bg-gold/10 border border-gold/30 text-gold text-sm font-bold rounded">
                101 {user.badge}
              </div>
            </div>
          ))}
        </div>
        <button class="mt-8 text-sm text-gold font-medium tracking-widest hover:text-gold-light text-left transition-colors">
          VIEW FULL LEADERBOARD →
        </button>
      </div>
    </div>
  </div>
</Layout>
